# Copy to .env and fill in, or run `bash setup/setup.sh`, which writes .env for you.
# docker compose reads .env from this folder.

# The image Argos is built on: plain Ubuntu, or a llama.cpp image when llama.cpp runs inside Argos
BASE_IMAGE=ubuntu
BASE_TAG=24.04

# Your models folder on the host (mounted at /app/models), and the one host port for everything
MODELS_DIR=./models
ARGOS_PORT=8080

# The web page password a new install starts with, read on its first start only; after that it is changed in
# Settings -> Security. Left empty as here: no login (only on a network you trust). Remove the line entirely and
# the password is "admin" (change it after). Or put your own after the =.
ARGOS_UI_PASSWORD=

# Postgres, when ARGOS_DATABASE_URL is set (see docs/postgres.md); setup.sh makes a random one
POSTGRES_PASSWORD=
